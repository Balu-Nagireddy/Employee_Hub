{
  "title": "Application",
  "uid": "application",
  "version": 1,
  "tags": ["application", "fastapi"],
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "title": "HTTP Requests per Second",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "{{method}} {{path}}"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
    },
    {
      "title": "Request Duration (P95)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[1m]))",
          "legendFormat": "P95 {{method}} {{path}}"
        }
      ],
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
    },
    {
      "title": "HTTP Status Codes",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(http_errors_total[1m])",
          "legendFormat": "Errors"
        }
      ],
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}
    },
    {
      "title": "Python Memory Usage",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "python_memory_bytes",
          "legendFormat": "{{type}}"
        }
      ],
      "gridPos": {"x": 0, "y": 16, "w": 8, "h": 8}
    },
    {
      "title": "Python CPU Time",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(python_cpu_seconds_total[1m])",
          "legendFormat": "CPU"
        }
      ],
      "gridPos": {"x": 8, "y": 16, "w": 8, "h": 8}
    },
    {
      "title": "Active Employees",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "active_employees",
          "legendFormat": "Active"
        }
      ],
      "gridPos": {"x": 16, "y": 16, "w": 8, "h": 8}
    }
  ]
}
