{
  "title": "Gateway",
  "uid": "gateway",
  "version": 1,
  "tags": ["gateway", "krakend"],
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "title": "Gateway Requests per Second",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(krakend_requests_total[1m])",
          "legendFormat": "Requests"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
    },
    {
      "title": "Gateway Latency (P95)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(krakend_request_duration_seconds_bucket[1m]))",
          "legendFormat": "P95"
        }
      ],
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
    },
    {
      "title": "Upstream Status Codes",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(krakend_requests_total[1m])",
          "legendFormat": "{{status_code}}"
        }
      ],
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
    },
    {
      "title": "Circuit Breaker Status",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "krakend_circuit_breaker_status",
          "legendFormat": "{{backend}}"
        }
      ],
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}
    }
  ]
}
